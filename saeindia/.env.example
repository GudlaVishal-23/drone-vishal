# =============================================================================
# SAE INDIA — Autonomous Drone Rescue & QR Mission System
# Configuration Variables
# =============================================================================

# Local Direct ESP32 WebSocket (used when running locally over HTTP)
VITE_ESP32_WS_URL=ws://192.168.31.194:8080/ws

# Production Secure Cloud Relay (Render.com)
VITE_SECURE_RELAY_URL=wss://saeindia-relay-server.onrender.com/ws
VITE_API_BASE_URL=https://saeindia-relay-server.onrender.com

# Secure Relay Authentication Token (must match RELAY_AUTH_TOKEN on your Render dashboard)
VITE_RELAY_TOKEN=YOUR_RENDER_TOKEN
VITE_API_TOKEN=YOUR_RENDER_TOKEN
