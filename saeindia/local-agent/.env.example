# =============================================================================
# SAE INDIA — Laptop RC-Agent Configuration
# =============================================================================

# Live Cloud Command Relay Server
CLOUD_URL=https://saeindia-relay-server.onrender.com

# Authentication Token (must match RELAY_AUTH_TOKEN on your Render dashboard)
RELAY_TOKEN=YOUR_RENDER_TOKEN

# RC Transmitter Hardware Configuration
# Protocols: CRSF (Crossfire / ELRS), SBUS, PPM, or MOCK
TX_PROTOCOL=CRSF

# Serial COM port for USB-connected transmitter (e.g., COM3 on Windows, /dev/ttyUSB0 on Linux)
TX_PORT=COM3

# Loop refresh rate in Hz (default: 50)
LOOP_RATE_HZ=50
