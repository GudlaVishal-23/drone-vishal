# =============================================================================
# SAE INDIA — Local Connector Agent Configuration
# =============================================================================

# ESP32 LAN IP Address and Port (on the same local Wi-Fi / subnet)
ESP32_HOST=192.168.31.194
ESP32_PORT=8080
ESP32_PATH=/ws

# Outbound Cloud Relay WSS Endpoint (No port forwarding needed!)
RELAY_URL=wss://saeindia-relay-server.onrender.com/connector

# Authentication Token matching RELAY_AUTH_TOKEN on your Render dashboard
RELAY_TOKEN=YOUR_RENDER_TOKEN
